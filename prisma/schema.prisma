// IndustryScope — Industrial Intelligence Domain Model
// SQLite (app-level tenant isolation by organizationId; no DB-level RLS).
// Money uses Decimal via String columns to preserve precision.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------------------------- Tenancy & Identity

model Organization {
  id          String   @id @default(cuid())
  name        String
  industry    String   @default("Manufacturing")
  region      String   @default("Middle East")
  currency    String   @default("USD")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sites       Site[]
  members     OrganizationMember[]
  products    Product[]
  suppliers   Supplier[]
  warehouses  Warehouse[]
  shipments   Shipment[]
  alerts      Alert[]
  risks       Risk[]
  recommendations Recommendation[]
  aiConversations AiConversation[]
  auditLogs   AuditLog[]
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("Analyst")
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// --------------------------------------------------------------------------- Sites & Facilities

model Site {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  type           String   @default("factory") // factory | warehouse | distribution | office
  region         String   @default("Tehran")
  lat            Float?
  lng            Float?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facilities     Facility[]
  warehouses     Warehouse[]

  @@index([organizationId])
}

model Facility {
  id        String   @id @default(cuid())
  siteId    String
  name      String
  type      String   @default("production") // production | storage | staging
  createdAt DateTime @default(now())

  site      Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

// --------------------------------------------------------------------------- Catalog

model Product {
  id             String   @id @default(cuid())
  organizationId String
  sku            String
  name           String
  category       String   @default("Raw Material")
  unit           String   @default("kg")
  unitCost       String   @default("0") // Decimal as string
  unitPrice      String   @default("0") // Decimal as string
  leadTimeDays   Int      @default(14)
  abcClass       String   @default("B") // A | B | C
  createdAt      DateTime @default(now())

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]
  shipmentItems  ShipmentItem[]
  movements      InventoryMovement[]

  @@unique([organizationId, sku])
  @@index([organizationId])
}

model Supplier {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  country        String   @default("IR")
  rating         Float    @default(0.8) // 0..1
  onTimeRate     Float    @default(0.85) // 0..1
  avgLeadDays    Int      @default(14)
  defectRate     Float    @default(0.02) // 0..1
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shipments      Shipment[]

  @@index([organizationId])
}

// --------------------------------------------------------------------------- Warehouse & Inventory

model Warehouse {
  id             String   @id @default(cuid())
  organizationId String
  siteId         String?
  name           String
  capacity       Int      @default(100000)
  createdAt      DateTime @default(now())

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site           Site?           @relation(fields: [siteId], references: [id])
  inventoryItems InventoryItem[]

  @@index([organizationId])
}

model InventoryItem {
  id           String   @id @default(cuid())
  organizationId String
  warehouseId  String
  productId    String
  onHand       Int      @default(0)
  reserved     Int      @default(0)
  safetyStock  Int      @default(0)
  reorderPoint Int      @default(0)
  updatedAt    DateTime @updatedAt

  warehouse    Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements     InventoryMovement[]

  @@unique([warehouseId, productId])
  @@index([organizationId])
}

model InventoryMovement {
  id           String   @id @default(cuid())
  productId    String
  warehouseId  String
  type         String   // receive | dispatch | transfer | adjust | reserve | release
  quantity     Int
  balanceAfter Int
  reason       String?
  createdAt    DateTime @default(now())

  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [warehouseId], references: [id])

  @@index([productId, warehouseId])
}

// --------------------------------------------------------------------------- Logistics

model Shipment {
  id             String   @id @default(cuid())
  organizationId String
  reference      String
  supplierId     String?
  originName     String
  originLat      Float?
  originLng      Float?
  destName       String
  destLat        Float?
  destLng        Float?
  carrier        String   @default("Internal Logistics")
  status         String   @default("PLANNED") // PLANNED | DISPATCHED | IN_TRANSIT | DELAYED | DELIVERED | CANCELLED
  eta            DateTime?
  dispatchedAt   DateTime?
  deliveredAt    DateTime?
  distanceKm     Float?
  progress       Float    @default(0) // 0..1
  delayMinutes   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier       Supplier?    @relation(fields: [supplierId], references: [id])
  items          ShipmentItem[]
  tracking       TrackingEvent[]

  @@index([organizationId])
}

model ShipmentItem {
  id         String @id @default(cuid())
  shipmentId String
  productId  String
  quantity   Int

  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@index([shipmentId])
}

model TrackingEvent {
  id         String   @id @default(cuid())
  shipmentId String
  status     String
  lat        Float?
  lng        Float?
  note       String?
  createdAt  DateTime @default(now())

  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

// --------------------------------------------------------------------------- Intelligence

model Alert {
  id             String   @id @default(cuid())
  organizationId String
  severity       String   // CRITICAL | HIGH | MEDIUM | LOW | INFO
  category       String   // inventory | logistics | supplier | production | system
  title          String
  message        String
  impact         String?
  recommendation String?
  source         String   @default("engine")
  confidence     Float    @default(0.85)
  status         String   @default("open") // open | acknowledged | resolved | dismissed
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

model Risk {
  id             String   @id @default(cuid())
  organizationId String
  dimension      String   // supplier | inventory | shipment | lead_time | demand | production
  title          String
  severity       String   // CRITICAL | HIGH | MEDIUM | LOW
  probability    Float    @default(0.5)  // 0..1
  impact         Float    @default(0.5)  // 0..1
  confidence     Float    @default(0.7)  // 0..1
  score          Float    @default(0.25) // probability*impact
  source         String   @default("engine")
  recommendation String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Recommendation {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  summary        String
  rationale      String
  action         String
  autonomyLevel   Int      @default(1) // 0 analyze | 1 recommend | 2 prepare | 3 approve | 4 autonomous
  status         String   @default("pending") // pending | approved | executed | dismissed
  impact         String?
  confidence     Float    @default(0.8)
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// --------------------------------------------------------------------------- AI Copilot

model AiConversation {
  id             String   @id @default(cuid())
  organizationId String
  title          String   @default("New Conversation")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       AiMessage[]

  @@index([organizationId])
}

model AiMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // user | assistant | system | tool
  content        String
  toolName       String?
  toolArgs       String?  // JSON
  toolResult     String?  // JSON
  confidence     Float?
  autonomyLevel   Int?
  createdAt       DateTime @default(now())

  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// --------------------------------------------------------------------------- Audit

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actor          String   @default("system")
  action         String
  resource       String
  resourceId     String?
  before         String?  // JSON
  after          String?  // JSON
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// --------------------------------------------------------------------------- Public inbound (CRM / marketing)
// These are NOT tenant-bound — they are public inbound leads for the
// IndustryScope business itself (the company selling the product).
// Used by the Contact, Demo-request, Quote-request, and Newsletter forms.

model Lead {
  id        String   @id @default(cuid())
  type      String   // contact | demo | quote | newsletter | partnership
  name      String?
  email     String
  phone     String?
  company   String?
  role      String?
  country   String?
  message   String?
  tier      String?  // for quote: starter | growth | enterprise
  sites     Int?
  status    String   @default("new") // new | contacted | qualified | won | lost
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status, createdAt])
  @@index([email])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("footer")
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  company   String
  quote     String
  rating    Int      @default(5)
  avatar    String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Article {
  id              String   @id @default(cuid())
  slug            String   @unique
  category        String
  title           String
  insight         String
  body            String   // markdown-ish full content
  stat            String?
  statLabel       String?
  delta           String?
  readMins        Int      @default(6)
  published       Boolean  @default(true)
  // SEO fields
  metaDescription String?
  keywords        String?  // comma-separated
  ogImage         String?
  // cross-links to other Scope products (for SEO)
  externalLinks   String?  // JSON array of {label, url}
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Key-value editable site content (admin-managed)
model SiteSetting {
  key       String   @id
  value     String   // text or JSON
  updatedAt DateTime @updatedAt
}

// --------------------------------------------------------------------------- Professional SaaS: User accounts, plans, subscriptions
// Multi-tenant SaaS billing: users sign up, pick a plan, get an organization,
// and consume the product. Tiered plans (Starter/Growth/Enterprise) map to pricing.

model Plan {
  id           String   @id @default(cuid())
  code         String   @unique  // starter | growth | enterprise
  name         String
  description  String
  priceMonthly Int      @default(0)   // in IRR (Rial) — stored as integer to avoid float
  priceYearly  Int      @default(0)
  maxUsers     Int      @default(5)
  maxSites     Int      @default(3)
  features     String   @default("[]") // JSON array of feature strings
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String?
  phone         String?
  role          String   @default("customer") // customer | admin
  emailVerified DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer      Customer?
  sessions      Session[]
  auditLogs     AuditLogPublic[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Customer {
  id            String   @id @default(cuid())
  userId        String   @unique  // 1:1 with User (the owner of this customer record)
  companyName   String
  industry      String   @default("Manufacturing")
  country       String   @default("Iran")
  status        String   @default("trial") // trial | active | suspended | cancelled
  trialEndsAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  usageRecords  UsageRecord[]
}

model Subscription {
  id              String   @id @default(cuid())
  customerId      String
  planId          String
  status          String   @default("active") // active | past_due | cancelled | ended
  billingCycle    String   @default("monthly") // monthly | yearly
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan            Plan     @relation(fields: [planId], references: [id])

  @@index([customerId])
}

model UsageRecord {
  id          String   @id @default(cuid())
  customerId  String
  metric      String   // ai_calls | shipments | sites | users
  count       Int      @default(0)
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, metric])
}

model AuditLogPublic {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  ip          String?
  meta        String?  // JSON
  createdAt   DateTime @default(now())

  user        User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}
